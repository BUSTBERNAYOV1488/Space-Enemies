mask_color = c_black;
transition_speed = 0.05;
a = 0; //The transparency (alpha) of the black mask. Starts at 0 (0%), goes to 1 (100%), and then back to 0.
fade_dir = 1; //Plus or minus one, depending on if we're increasing the transparency of the black mask (+) or decreasing (-)
status = "null"; //Determines whether we go to the next room or do something else.


